#!/usr/bin/bash
# omarchy-hotspot-helper: concurrent Wi-Fi hotspot for the local.hotspot bar
# plugin. The station interface stays connected to the current network while
# a virtual AP interface (ap0) serves clients via hostapd + dnsmasq. Traffic
# is NATed through the default route, so any uplink (Ethernet, tether,
# VLAN-tagged interface, or the Wi-Fi network itself) is shared.
#
# The AP must mirror the station's channel AND channel width: iwlwifi keeps a
# single phy context per radio and silently fails to beacon otherwise.
#
# Started via pkexec by the panel; a polkit rule makes that passwordless.
set -euo pipefail
umask 077

# The helper crosses a passwordless privilege boundary. Do not resolve any
# executable from caller-controlled environment state. Every external command
# is dispatched through this fixed, root-owned allowlist.
caller_uid="${PKEXEC_UID:-}"
while IFS= read -r environment_name; do
  unset "$environment_name" 2>/dev/null || true
done < <(compgen -e)
if [[ "$caller_uid" =~ ^[0-9]+$ ]]; then
  export PKEXEC_UID="$caller_uid"
fi
# shellcheck disable=SC2123 # Deliberately disable command lookup across the privilege boundary.
PATH=/nonexistent
export PATH
export LANG=C.UTF-8
export LC_ALL=C.UTF-8

nmcli() { /usr/bin/nmcli "$@"; }
grep() { /usr/bin/grep "$@"; }
head() { /usr/bin/head "$@"; }
cut() { /usr/bin/cut "$@"; }
awk() { /usr/bin/awk "$@"; }
iw() { /usr/bin/iw "$@"; }
systemctl() { /usr/bin/systemctl "$@"; }
systemd-run() { /usr/bin/systemd-run "$@"; }
seq() { /usr/bin/seq "$@"; }
sleep() { /usr/bin/sleep "$@"; }
tr() { /usr/bin/tr "$@"; }
cat() { /usr/bin/cat "$@"; }
dirname() { /usr/bin/dirname "$@"; }
stat() { /usr/bin/stat "$@"; }
wc() { /usr/bin/wc "$@"; }
ip() { /usr/bin/ip "$@"; }
iptables() { /usr/bin/iptables "$@"; }
sysctl() { /usr/bin/sysctl "$@"; }
hostapd_cli() { /usr/bin/hostapd_cli "$@"; }
readonly -f nmcli grep head cut awk iw systemctl systemd-run seq sleep
readonly -f tr cat dirname stat wc
readonly -f ip iptables sysctl hostapd_cli

readonly STATE_TOOL="/usr/local/lib/omarchy-hotspot-secure-state"
readonly DEVICE_ID_TOOL="/usr/local/lib/omarchy-hotspot-device-identification.sh"
readonly DISCOVER_TOOL="/usr/local/lib/omarchy-hotspot-discover-device.sh"

verify_root_tool() {
  local path="$1" owner mode
  if [ ! -f "$path" ] || [ -L "$path" ]; then
    echo "unsafe helper dependency: $path" >&2
    return 1
  fi
  owner="$(stat -c %u "$path")"
  mode="$(stat -c %a "$path")"
  [ "$owner" = 0 ] || { echo "helper dependency is not root-owned: $path" >&2; return 1; }
  (( (8#$mode & 8#022) == 0 )) || { echo "helper dependency is writable by non-root: $path" >&2; return 1; }
}

state_store() {
  /usr/bin/python3 "$STATE_TOOL" "$@"
}

VIF="ap0"
RUN_DIR="/run/omarchy-hotspot"
STATE_DIR="/var/lib/omarchy-hotspot"
AP_CONF="$RUN_DIR/hostapd.conf"
AP_SUBNET="10.42.0.0/24"
AP_GATEWAY="10.42.0.1"
LEASE_FILE="$RUN_DIR/dnsmasq.leases"
OUI_FILE="/usr/share/hwdata/oui.txt"
METADATA_FILE="$RUN_DIR/device-metadata.tsv"
DISCOVERY_FILE="$RUN_DIR/device-discovery.tsv"
ALIASES_FILE="$STATE_DIR/device-aliases.tsv"
BLOCKED_FILE="$STATE_DIR/blocked-devices.tsv"

if (( EUID == 0 )); then
  verify_root_tool "$STATE_TOOL"
  verify_root_tool "$DEVICE_ID_TOOL"
  verify_root_tool "$DISCOVER_TOOL"
  # Installed alongside this helper by install.sh.
  # shellcheck disable=SC1090,SC1091
  source "$DEVICE_ID_TOOL"
else
  # Unprivileged development fallback. The passwordless installed path never
  # sources code from the user-writable checkout.
  # shellcheck disable=SC1090,SC1091
  source "$(dirname "${BASH_SOURCE[0]}")/device-identification.sh"
fi

station_iface() {
  nmcli -t -f DEVICE,TYPE device status 2>/dev/null | grep -E ':wifi$' | head -1 | cut -d: -f1
}

station_channel() {
  local iface
  iface="$(station_iface)"
  [ -n "$iface" ] || return 0
  iw dev "$iface" info 2>/dev/null | awk '/channel/ { print $2; exit }'
}

# Channel width the station uses ("20", "40", "80", "160"). iw prints one
# line: "channel 1 (2412 MHz), width: 40 MHz, center1: 2422 MHz".
station_width() {
  local iface
  iface="$(station_iface)"
  [ -n "$iface" ] || return 0
  iw dev "$iface" info 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "width:") { print $(i + 1); exit } }'
}

# "plus" | "minus" | "" — secondary channel direction from center frequency.
station_center_offset() {
  local iface ch primary center
  iface="$(station_iface)"
  [ -n "$iface" ] || return 0
  ch="$(station_channel)"
  center="$(iw dev "$iface" info 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "center1:") { print $(i + 1); exit } }')"
  [ -n "$center" ] || return 0
  if [ "$ch" -le 14 ]; then
    primary=$((2412 + (ch - 1) * 5))
  else
    primary=$((5000 + ch * 5))
  fi
  if [ "$center" -gt "$primary" ]; then
    echo "plus"
  elif [ "$center" -lt "$primary" ]; then
    echo "minus"
  fi
}

# Center frequency (MHz) of the station's phy context (center1). iwlwifi
# keeps a single phy context per radio, so the AP must use this exact center
# (not an arbitrary one derived from the primary channel) or hostapd fails
# with "Frequency not present (seg0)"/"Hardware does not support configured
# channel" on asymmetric primary channels (e.g. ch157 in an 80 MHz block
# centered at 5775 MHz).
station_vht_center() {
  local iface
  iface="$(station_iface)"
  [ -n "$iface" ] || return 0
  iw dev "$iface" info 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "center1:") { print $(i + 1); exit } }'
}

ap_ssid() {
  state_store read-ssid
}

vif_exists() {
  iw dev "$VIF" info >/dev/null 2>&1
}

hotspot_on() {
  systemctl is-active --quiet omarchy-hotspot 2>/dev/null
}

wait_for_hostapd() {
  # Continue as soon as systemd reports the AP ready; a fixed one-second wait
  # made every toggle feel slower even when hostapd started quickly.
  for _ in $(seq 1 20); do
    systemctl is-active --quiet omarchy-hotspot 2>/dev/null && return 0
    sleep 0.05
  done
  return 1
}

ensure_state() {
  state_store init
}

ensure_vif() {
  vif_exists && return 0
  local iface phy
  iface="$(station_iface)"
  [ -n "$iface" ] || { echo "no-wifi-device" >&2; return 1; }
  phy="phy$(iw dev "$iface" info | awk '/wiphy/ { print $2; exit }')"
  iw phy "$phy" interface add "$VIF" type __ap
  # The RTL8723DE firmware rejects concurrent interfaces with one MAC.
  # Derive a stable locally administered address from the station address.
  local ap_mac
  ap_mac="$(cat "/sys/class/net/$iface/address")"
  ap_mac="02${ap_mac:2}"
  ip link set "$VIF" address "$ap_mac"
  for _ in $(seq 1 20); do
    vif_exists && return 0
    sleep 0.2
  done
  echo "vif-create-timeout" >&2
  return 1
}

write_hostapd_conf() {
  local channel freq mode ht seg0 seg1 chwidth
  channel="$(station_channel)"
  if [ -z "$channel" ]; then
    channel=1
  fi
  if [ "$channel" -le 14 ]; then
    mode="g"
    freq=$((2412 + (channel - 1) * 5))
  else
    mode="a"
    freq=$((5000 + channel * 5))
  fi

  # Mirror the station's width AND phy-context center (center1) so the
  # firmware beacons on the shared phy. Using the actual center1 avoids the
  # "Frequency not present (seg0)" failure when the primary channel sits
  # asymmetrically inside the VHT80/160 block.
  case "$(station_width)" in
    40)
      if [ "$(station_center_offset)" = "minus" ]; then
        ht="[HT40-]"
      else
        ht="[HT40+]"
      fi
      ;;
    80)
      ht="[HT40+]"
      chwidth=1
      local vhtcenter80
      vhtcenter80="$(station_vht_center)"
      if [ -n "$vhtcenter80" ]; then
        seg0=$(((vhtcenter80 - 5000) / 5))
      else
        # Fallback: primary at the low edge of the 80 MHz block.
        seg0=$(((freq + 20 - 5000) / 5))
      fi
      ;;
    160)
      ht="[HT40+]"
      chwidth=2
      local vhtcenter
      vhtcenter="$(station_vht_center)"
      seg0=$(((vhtcenter - 5000) / 5))
      # seg1 = center of the 80 MHz half that does NOT hold the primary.
      if [ "$freq" -lt "$vhtcenter" ]; then
        seg1=$(((vhtcenter + 40 - 5000) / 5))
      else
        seg1=$(((vhtcenter - 40 - 5000) / 5))
      fi
      ;;
    *)
      ht="[HT20]"
      ;;
  esac

  state_store write-hostapd <<EOF
interface=$VIF
driver=nl80211
ctrl_interface=/run/hostapd
ssid=$(ap_ssid)
hw_mode=$mode
channel=$channel
wpa=2
wpa_passphrase=$(state_store read-password)
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
ht_capab=$ht
${seg0:+ieee80211ac=1}
${seg0:+vht_oper_chwidth=$chwidth}
${seg0:+vht_oper_centr_freq_seg0_idx=$seg0}
${seg1:+vht_oper_centr_freq_seg1_idx=$seg1}
ignore_broadcast_ssid=0
deny_mac_file=$BLOCKED_FILE
EOF
}

start_ap() {
  ensure_state
  # A failed or interrupted stop can leave ap0 behind while the service is
  # inactive. Reusing that stale interface causes kernel "Name not unique"
  # errors and can retain the station's MAC address.
  if vif_exists && ! hotspot_on; then
    iw dev "$VIF" del 2>/dev/null || true
  fi
  ensure_vif
  write_hostapd_conf

  ip link set "$VIF" up
  systemctl stop omarchy-hotspot 2>/dev/null || true
  # Transient unit: keeps hostapd in foreground (no -B fork bugs), logs to
  # journald, and survives the pkexec session.
  if ! systemd-run --unit=omarchy-hotspot --collect /usr/bin/hostapd "$AP_CONF"; then
    iw dev "$VIF" del 2>/dev/null || true
    exit 1
  fi
  if ! wait_for_hostapd; then
    echo "hostapd failed to start (journalctl -u omarchy-hotspot)" >&2
    iw dev "$VIF" del 2>/dev/null || true
    exit 1
  fi
  ip addr replace "$AP_GATEWAY/24" dev "$VIF" 2>/dev/null || true
  ip link set "$VIF" up

  # Forward + NAT through the default route (any uplink, VLAN included).
  sysctl -q -w net.ipv4.ip_forward=1
  iptables -t nat -C POSTROUTING -s "$AP_SUBNET" ! -d "$AP_SUBNET" -j MASQUERADE 2>/dev/null \
    || iptables -t nat -A POSTROUTING -s "$AP_SUBNET" ! -d "$AP_SUBNET" -j MASQUERADE
  iptables -C FORWARD -i "$VIF" -j ACCEPT 2>/dev/null \
    || iptables -I FORWARD -i "$VIF" -j ACCEPT
  iptables -C FORWARD -o "$VIF" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null \
    || iptables -I FORWARD -o "$VIF" -m state --state RELATED,ESTABLISHED -j ACCEPT
  # INPUT: UFW's default DROP policy eats client DHCP/DNS (ports 67/53).
  # WPA2-authenticated AP clients are trusted; accept everything from ap0.
  iptables -C INPUT -i "$VIF" -j ACCEPT 2>/dev/null \
    || iptables -I INPUT -i "$VIF" -j ACCEPT

  # DHCP/DNS for clients; explicit upstreams (systemd-resolved's, else CDN).
  local servers=()
  while read -r ns; do
    case "$ns" in
      # systemd-resolved can emit scoped link-local IPv6 DNS servers such as
      # fe80::1%2. dnsmasq expects a usable interface scope there, but the
      # numeric scope ID from resolv.conf is rejected as a bad interface name.
      # Ignore scoped/link-local resolvers and use the remaining upstreams (or
      # the public fallback below) instead.
      127.*|::1|fe80:*|*%*|"") ;;
      *) servers+=(--server="$ns") ;;
    esac
  done < <(grep '^nameserver' /run/systemd/resolve/resolv.conf 2>/dev/null | awk '{print $2}' || true)
  if [ "${#servers[@]}" -eq 0 ]; then
    servers=(--server=1.1.1.1 --server=1.0.0.1)
  fi
  systemctl stop omarchy-hotspot-dns 2>/dev/null || true
  systemd-run --unit=omarchy-hotspot-dns --collect /usr/bin/dnsmasq \
    --keep-in-foreground \
    --interface="$VIF" \
    --bind-interfaces \
    --except-interface=lo \
    --no-resolv \
    --log-dhcp \
    --dhcp-leasefile="$LEASE_FILE" \
    --dhcp-script=/usr/local/lib/omarchy-hotspot-lease-event.sh \
    "${servers[@]}" \
    --dhcp-range=10.42.0.10,10.42.0.200,255.255.255.0,12h
}

stop_ap() {
  systemctl stop omarchy-hotspot 2>/dev/null || true
  systemctl stop omarchy-hotspot-dns 2>/dev/null || true
  iptables -D INPUT -i "$VIF" -j ACCEPT 2>/dev/null || true
  iptables -t nat -D POSTROUTING -s "$AP_SUBNET" ! -d "$AP_SUBNET" -j MASQUERADE 2>/dev/null || true
  iptables -D FORWARD -i "$VIF" -j ACCEPT 2>/dev/null || true
  iptables -D FORWARD -o "$VIF" -m state --state RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || true
  # Fresh AP-mode vif on next start (hostapd/wpa leaves stale state otherwise).
  iw dev "$VIF" del 2>/dev/null || true
}

uplink_iface() {
  ip route get 8.8.8.8 2>/dev/null | awk '{ for (i=1; i<=NF; i++) if ($i == "dev") print $(i+1); exit }' || true
}

status_text() {
  if ! hotspot_on; then
    printf 'off\t%s\n' "$(ap_ssid)"
    return
  fi
  local iface channel clients
  iface="$(station_iface)"
  channel="$(iw dev "$iface" info 2>/dev/null | awk '/channel/ { print $2; exit }')"
  if [ -z "$channel" ]; then
    channel="$(iw dev "$VIF" info 2>/dev/null | awk '/channel/ { print $2; exit }')"
  fi
  clients="$(iw dev "$VIF" station dump 2>/dev/null | grep -c '^Station' || true)"
  # The passphrase is intentionally not included in the general status output.
  # The panel requests it only through the dedicated bounded helper action.
  printf 'on\t%s\t%s\t%s\t%s\n' "$(ap_ssid)" "$(uplink_iface)" "${channel:-}" "${clients:-0}"
}

schedule_device_discovery() {
  local mac="$1" ip="$2" unit
  valid_mac "$mac" || return 0
  [[ "$ip" =~ ^[0-9a-fA-F:.]+$ ]] || return 0
  unit="omarchy-hotspot-discover-${mac//:/}.service"
  systemd-run --quiet --collect --unit="$unit" \
    /usr/bin/timeout --signal=KILL 2 /usr/bin/bash "$DISCOVER_TOOL" "$mac" "$ip" \
    >/dev/null 2>&1 || true
}

clients_text() {
  vif_exists || return 0
  local leases="$LEASE_FILE"
  [ -r "$leases" ] || leases="/var/lib/misc/dnsmasq.leases"
  iw dev "$VIF" station dump 2>/dev/null | awk '
    /^Station / { mac=$2; signal=""; connected="" }
    /^\tsignal:/ { signal=$2 }
    /^\tconnected time:/ { connected=$3; if (mac != "") print mac "\t" signal "\t" connected }
  ' | while IFS=$'\t' read -r mac signal connected; do
    local ip resolved label source discovery_ip discovery_attempt
    ip="$(lease_ip "$mac" "$leases")"
    resolved="$(resolve_device "$mac" "$ip" "$METADATA_FILE" "$DISCOVERY_FILE" "$ALIASES_FILE" "$OUI_FILE")"
    label="${resolved%%$'\t'*}"
    source="${resolved#*$'\t'}"
    case "$source" in
      unknown|vendor)
        discovery_ip="$(tsv_value "$mac" "$DISCOVERY_FILE" 2)"
        discovery_attempt="$(tsv_value "$mac" "$DISCOVERY_FILE" 5)"
        if [ -n "$ip" ] && { [ "$discovery_ip" != "$ip" ] \
          || ! [[ "$discovery_attempt" =~ ^[0-9]+$ ]] \
          || (( EPOCHSECONDS - discovery_attempt >= 60 )); }; then
          schedule_device_discovery "$mac" "$ip"
        fi
        ;;
    esac
    printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$mac" "$ip" "$signal" "$connected" "$label" "$source"
  done
}

set_alias_from_stdin() {
  local mac alias
  IFS= read -r -n 18 mac || true
  IFS= read -r -n 193 alias || true
  printf '%s\n%s\n' "$mac" "$alias" | state_store set-alias
  echo "ok"
}

current_device_label() {
  local mac="${1,,}" leases="$LEASE_FILE" ip resolved
  [ -r "$leases" ] || leases="/var/lib/misc/dnsmasq.leases"
  ip="$(lease_ip "$mac" "$leases")"
  resolved="$(resolve_device "$mac" "$ip" "$METADATA_FILE" "$DISCOVERY_FILE" "$ALIASES_FILE" "$OUI_FILE")"
  printf '%s\n' "${resolved%%$'\t'*}"
}

disconnect_device() {
  local mac="${1,,}"
  valid_mac "$mac" || { echo "Invalid device address" >&2; return 1; }
  hotspot_on || { echo "Hotspot is off" >&2; return 1; }
  hostapd_cli -p /run/hostapd -i "$VIF" deauthenticate "$mac" | grep -qx OK
}

block_connected_device() {
  local mac="${1,,}" label
  valid_mac "$mac" || { echo "Invalid device address" >&2; return 1; }
  label="$(current_device_label "$mac")"
  printf '%s\n%s\n' "$mac" "$label" | state_store block
  if hotspot_on; then
    hostapd_cli -p /run/hostapd -i "$VIF" deny_acl ADD_MAC "$mac" | grep -qx OK
    hostapd_cli -p /run/hostapd -i "$VIF" deauthenticate "$mac" | grep -qx OK
  fi
}

unblock_connected_device() {
  local mac="${1,,}"
  valid_mac "$mac" || { echo "Invalid device address" >&2; return 1; }
  printf '%s\n' "$mac" | state_store unblock
  if hotspot_on; then
    hostapd_cli -p /run/hostapd -i "$VIF" deny_acl DEL_MAC "$mac" | grep -qx OK
  fi
}

blocked_text() {
  state_store read-blocked
}

password_text() {
  state_store read-password
  printf '\n'
}

set_password() {
  local newpass byte_len
  # Read the passphrase from stdin (never argv) so it is not exposed via the
  # process command line. Invoke as: printf '%s\n' "$pw" | helper set-password
  # A single line is read, so the caller sends a trailing newline and need not
  # close the stream (which would break repeated invocations).
  IFS= read -r -n 64 newpass || true
  if [ -z "$newpass" ]; then
    echo "No password provided on stdin" >&2
    return 1
  fi
  # WPA2-PSK passphrase rules: 8-63 bytes of printable ASCII. Reject control
  # characters, DEL, and any non-ASCII byte (UTF-8 would blow the 63-byte
  # limit once encoded and could break hostapd.conf interpolation). Compare
  # the total byte count against the printable-byte count so an embedded
  # newline (which grep/command-substitution treat as a line break) is caught.
  local total printable
  total="$(printf '%s' "$newpass" | wc -c)"
  printable="$(printf '%s' "$newpass" | LC_ALL=C tr -cd '[:print:]' | wc -c)"
  if [ "$total" -ne "$printable" ]; then
    echo "Password must contain only printable ASCII characters" >&2
    return 1
  fi
  byte_len="$(printf '%s' "$newpass" | wc -c)"
  if [ "$byte_len" -lt 8 ] || [ "$byte_len" -gt 63 ]; then
    echo "Password must be between 8 and 63 characters" >&2
    return 1
  fi
  ensure_state
  printf '%s' "$newpass" | state_store write-password
  if hotspot_on; then
    write_hostapd_conf
    systemctl restart omarchy-hotspot
    if ! wait_for_hostapd; then
      echo "hostapd failed to restart with the new password" >&2
      return 1
    fi
  fi
  echo "ok"
}

set_ssid() {
  local newssid byte_len
  IFS= read -r -n 33 newssid || true
  if [ -z "$newssid" ]; then
    echo "No SSID provided on stdin" >&2
    return 1
  fi
  local total printable
  total="$(printf '%s' "$newssid" | wc -c)"
  printable="$(printf '%s' "$newssid" | LC_ALL=C tr -cd '[:print:]' | wc -c)"
  if [ "$total" -ne "$printable" ]; then
    echo "SSID must contain only printable characters" >&2
    return 1
  fi
  byte_len="$(printf '%s' "$newssid" | wc -c)"
  if [ "$byte_len" -lt 1 ] || [ "$byte_len" -gt 32 ]; then
    echo "SSID must be between 1 and 32 characters" >&2
    return 1
  fi
  ensure_state
  printf '%s' "$newssid" | state_store write-ssid
  if hotspot_on; then
    write_hostapd_conf
    systemctl restart omarchy-hotspot
    if ! wait_for_hostapd; then
      echo "hostapd failed to restart with the new SSID" >&2
      return 1
    fi
  fi
  echo "ok"
}

# The passwordless pkexec polkit rule lets the bar run this helper as root.
# This dispatch is the complete privileged allowlist.
helper_dispatch() {
  case "$1" in
    status) status_text ;;
    read-password) password_text ;;
    clients) clients_text ;;
    blocked) blocked_text ;;
    toggle)
      if hotspot_on; then
        stop_ap
      else
        start_ap
      fi
      ;;
    set-password) set_password ;;
    set-ssid) set_ssid ;;
    set-device-alias) set_alias_from_stdin ;;
    disconnect-device) disconnect_device "${2:-}" ;;
    block-device) block_connected_device "${2:-}" ;;
    unblock-device) unblock_connected_device "${2:-}" ;;
    *)
      echo "usage: omarchy-hotspot-helper {status|read-password|clients|blocked|toggle|set-password|set-ssid|set-device-alias|disconnect-device|block-device|unblock-device}" >&2
      exit 2
      ;;
  esac
}

if (( $# == 0 )); then
  set -- status
fi
helper_dispatch "$@"
